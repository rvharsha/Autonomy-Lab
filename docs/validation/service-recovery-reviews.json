{
  "completed_reviews": 9,
  "dispositions": [
    {
      "disposition": "rejected",
      "finding": "SIGTERM can bypass controller finally blocks",
      "reason": "This is the failure boundary being tested. Systemd post-stop accounting does not require controller receipts and intentionally leaves uncommitted attempts unassessed; SIGKILL must be supported as well.",
      "scope": "service_lifecycle"
    },
    {
      "disposition": "fixed",
      "finding": "Credential removal followed potentially slow Docker cleanup",
      "reason": "Credential revocation and a distinct progress receipt precede cleanup; regression test covers blocked cleanup.",
      "scope": "service_lifecycle"
    },
    {
      "disposition": "not_reproduced_with_explicit_guard_added",
      "finding": "Scenario shuffle can put healthy before routing",
      "reason": "planned_trials preserves scenario order and shuffles only variants. The gate now additionally checks its exact two-row ordered plan.",
      "scope": "service_gate"
    },
    {
      "disposition": "rejected",
      "finding": "trial.json could be read while torn",
      "reason": "harness.save fsyncs a temporary file and atomically replaces the target; run_trial publishes its initial record before tool observations.",
      "scope": "service_gate"
    },
    {
      "disposition": "fixed",
      "finding": "Gate timeout covered only one of two systemd stop phases",
      "reason": "Trigger command and stop cleanup allow 630 seconds for the 300-second process stop and 300-second post-stop phases.",
      "scope": "service_gate"
    },
    {
      "disposition": "fixed",
      "finding": "Missing accounting could hide the failed post-stop receipt",
      "reason": "Gate retains and checks the post-stop receipt before opening accounting.",
      "scope": "service_gate"
    },
    {
      "disposition": "fixed",
      "finding": "Liveness probe exception could bypass revocation and receipts",
      "reason": "Credentials are removed first; liveness errors produce a durable failed receipt and refuse resource cleanup. Authored timeout regression verifies this ordering.",
      "scope": "service_gate"
    },
    {
      "disposition": "rejected",
      "finding": "Second finalize can hit liveness failure despite an existing receipt",
      "reason": "The existing immutable receipt returns before the liveness guard. Gate checks the failed unit before final stop and never resets failed units.",
      "scope": "service_gate"
    },
    {
      "disposition": "fixed",
      "finding": "Asynchronous restart could expose inactive state before new invocation",
      "reason": "Wait for the systemctl restart job, including its new start phase, before checking the refused invocation.",
      "scope": "service_gate"
    },
    {
      "disposition": "unsubstantiated_observation",
      "finding": "Journald ingestion might delay restart refusal text",
      "reason": "No reproduction provided. Real restart gate requires actual persisted refusal evidence and fails if it is absent; it does not infer a passing restart.",
      "scope": "service_gate"
    },
    {
      "disposition": "rejected",
      "finding": "No probe records produce backend_error_observed=false",
      "reason": "The field means whether an error exposure occurred in a complete journal, not whether a backend was healthy. Applicable validation requires this field to be true; missing exposure cannot pass. Truncated or unavailable evidence remains unknown.",
      "scope": "fallback_validation"
    },
    {
      "disposition": "rejected",
      "finding": "Missing quotes in trusted verifier output can raise instead of returning false",
      "reason": "verify.collect populates quotes before returning every snapshot. A thrown collection exception produces no partial snapshot. Malformed evidence fails closed as infrastructure error; no actor or promotion gate can bypass establishment.",
      "scope": "fallback_validation"
    }
  ],
