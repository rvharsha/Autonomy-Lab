+// runtimeTaskYAML excludes controller state from the immutable execution template.
+// Suspension changes the actor lifecycle, not its boot configuration.
+func runtimeTaskYAML(task *v1alpha1.Task) ([]byte, error) {
+	boot := proto.Clone(task).(*v1alpha1.Task)
+	boot.Status = nil
+	boot.Metadata = &v1alpha1.ObjectMeta{Name: task.Metadata.Name, Atespace: task.Metadata.Atespace}
+	boot.Spec.Suspend = false
+	return yaml.Marshal(boot)
+}
